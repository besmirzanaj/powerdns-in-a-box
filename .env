MYSQL_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT

PDNS_DB_NAME=pdns
PDNS_DB_USER=pdns
PDNS_DB_PASS=CHANGE_ME_PDNS_DB
PDNS_API_KEY=CHANGE_ME_API_KEY

PDA_DB_NAME=powerdns_admin
PDA_DB_USER=pda
PDA_DB_PASS=CHANGE_ME_PDA_DB
PDA_SECRET_KEY=CHANGE_ME_PDA_SECRET

PDA_ADMIN_USERNAME=admin
PDA_ADMIN_PASSWORD=CHANGE_ME_PDA_ADMIN
PDA_ADMIN_EMAIL=admin@example.com

# Host IP that dnsdist will bind to for port 53.
# Use the server's public IPv4. Leave blank to bind to 0.0.0.0 (only works
# if no other process is holding port 53 on the host, including aardvark-dns).
DNSDIST_BIND_IP=
