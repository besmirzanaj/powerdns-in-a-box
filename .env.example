# Copy to .env, then replace every CHANGE_ME_* with a strong random value.
# The PDNS API key appears in pdns/pdns.conf and provisioning.yaml —
# substitute them everywhere in lockstep.
# See README "Quickstart" for the openssl one-liner that does it.

PDNS_API_KEY=CHANGE_ME_API_KEY

# PowerDNS-AuthAdmin secrets. Generate each with:
#   openssl rand -base64 32
PDA_SECRET_KEY=CHANGE_ME_PDA_SECRET
PDA_ENCRYPTION_KEY=CHANGE_ME_PDA_ENCRYPTION

# Bootstrap admin — created automatically on first boot.
PDA_ADMIN_EMAIL=admin@example.com
PDA_ADMIN_PASSWORD=CHANGE_ME_PDA_ADMIN

# Web basic-auth password and API key for the dnsdist console on port 8083.
DNSDIST_WEBSERVER_PASSWORD=CHANGE_ME_DNSDIST_WEB
DNSDIST_API_KEY=CHANGE_ME_DNSDIST_API

# Host IP that dnsdist binds port 53 to. Use the server's public IPv4.
# Leave blank to bind 0.0.0.0 — only safe if no other process holds port
# 53 on the host (e.g. systemd-resolved, aardvark-dns from another podman
# stack). See README "Port 53" for details.
DNSDIST_BIND_IP=

# Optional: host IP that the management ports (8081, 8083, 9090) are
# published on, in addition to 127.0.0.1. Typically the host's Tailscale
# IPv4 (`tailscale ip -4` on the host). Leave blank to keep management
# ports loopback-only and use SSH tunnels.
TAILSCALE_BIND_IP=